{
  "name": "holbertonschool-analyse-et-conception",
  "version": "1.0.0",
  "description": "Cucumber-js setup for Gherkin feature tests",
  "scripts": {
    "test": "cucumber-js blueprint_stockmaster/04_business_specs.feature --require blueprint_stockmaster/steps/*.js",
    "db:start": "docker compose -f blueprint_stockmaster/compose.yaml up -d",
    "db:stop": "docker compose -f blueprint_stockmaster/compose.yaml down",
    "test:full": "npm run db:start && sleep 5 && npm test && npm run db:stop"
  },
  "dependencies": {
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0"
  }
}
